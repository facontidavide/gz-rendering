// gz-rendering material with lighting disabled: flat color / texture.
material {
    name : gz_unlit,
    shadingModel : unlit,
    requires : [ uv0 ],
    parameters : [
        { type : float4,    name : baseColor },
        { type : int,       name : hasTexture },
        { type : sampler2d, name : baseColorMap }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = materialParams.baseColor;
        if (materialParams.hasTexture != 0) {
            c *= texture(materialParams_baseColorMap, getUV0());
        }
        material.baseColor = c;
    }
}
